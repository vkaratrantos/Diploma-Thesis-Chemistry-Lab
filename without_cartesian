// --- Standard C++ Libraries ---
#include <memory>   
#include <thread>   
#include <iostream> 
#include <string>   
#include <sstream>  
#include <cmath>    

// --- ROS 2 & MoveIt 2 Libraries ---
#include <rclcpp/rclcpp.hpp> 
#include <moveit/move_group_interface/move_group_interface.h> 
#include <moveit_msgs/msg/constraints.hpp>
#include <moveit_msgs/msg/orientation_constraint.hpp>
#include <geometry_msgs/msg/pose.hpp>
#include <tf2/LinearMath/Quaternion.h>
#include <moveit/planning_scene_interface/planning_scene_interface.h>
#include <moveit_msgs/msg/collision_object.hpp>
#include <shape_msgs/msg/solid_primitive.hpp>

int main(int argc, char * argv[])
{
    // =========================================================================
    // 1. SYSTEM INITIALIZATION
    // =========================================================================
    rclcpp::init(argc, argv);
    auto node = std::make_shared<rclcpp::Node>("interactive_pose_planner");

    // =========================================================================
    // 2. BACKGROUND THREADING
    // =========================================================================
    auto executor = std::make_shared<rclcpp::executors::MultiThreadedExecutor>();
    executor->add_node(node);
    std::thread spinner([executor]() { executor->spin(); });

    // =========================================================================
    // 3. MOVEIT INTERFACE SETUP
    // =========================================================================
    using moveit::planning_interface::MoveGroupInterface;
    MoveGroupInterface arm_interface(node, "arm_group");

    arm_interface.setPlanningTime(1.0);
    arm_interface.setMaxVelocityScalingFactor(0.3);
    arm_interface.setMaxAccelerationScalingFactor(0.3);
    
    // =========================================================================
    // 3.5 ADDING THE COLLISION FLOOR
    // =========================================================================
    std::cout << ">>> Spawning collision floor..." << std::endl;
    
    // The PlanningSceneInterface is how we inject objects into the robot's world
    moveit::planning_interface::PlanningSceneInterface planning_scene_interface;
    moveit_msgs::msg::CollisionObject floor_object;
    
    // Attach it to the robot's base frame
    floor_object.header.frame_id = arm_interface.getPlanningFrame();
    floor_object.id = "safety_floor";

    // Define a massive, flat box (2m x 2m, 4cm thick)
    shape_msgs::msg::SolidPrimitive primitive;
    primitive.type = primitive.BOX;
    primitive.dimensions = {2.0, 2.0, 0.04}; 

    // Position the box directly beneath the robot.
    // Setting Z to -0.04 puts the TOP surface of the box at slightly below Z=0.0
    geometry_msgs::msg::Pose box_pose;
    box_pose.position.x = 0.0;
    box_pose.position.y = 0.0;
    box_pose.position.z = -0.04; 

    // Apply the shape and pose to the collision object
    floor_object.primitives.push_back(primitive);
    floor_object.primitive_poses.push_back(box_pose);
    floor_object.operation = floor_object.ADD;

    // Send the object to the MoveIt planning scene
    planning_scene_interface.applyCollisionObjects({floor_object});
    
    // Give MoveIt a split second to register the new object before we start planning
    std::this_thread::sleep_for(std::chrono::milliseconds(500));

    // =========================================================================
    // 4. INITIAL STARTUP MOTION (EXACT POSE)
    // =========================================================================
    std::cout << ">>> Moving to initial position (X:0.0, Y:-0.2, Z:0.2) ..." << std::endl;
    std::cout << ">>> Orientation: Roll=0, Pitch=-90, Yaw=90 ..." << std::endl;

    arm_interface.clearPoseTargets();
    arm_interface.clearPathConstraints();

    geometry_msgs::msg::Pose start_pose;
    start_pose.position.x = 0.0;
    start_pose.position.y = -0.2;
    start_pose.position.z = 0.2;

    // We define your perfect orientation here
    tf2::Quaternion q_start;
    q_start.setRPY(0.0, -M_PI/2.0, M_PI/2.0); 
    
    start_pose.orientation.x = q_start.x();
    start_pose.orientation.y = q_start.y();
    start_pose.orientation.z = q_start.z();
    start_pose.orientation.w = q_start.w();

    arm_interface.setPoseTarget(start_pose);
    arm_interface.setPlanningTime(2.0); 
    
    MoveGroupInterface::Plan initial_plan;
    bool initial_success = (arm_interface.plan(initial_plan) == moveit::core::MoveItErrorCode::SUCCESS);

    if (initial_success) {
        arm_interface.execute(initial_plan);
        std::cout << ">>> Initial position reached successfully!" << std::endl;
    } else {
        std::cout << "[-] WARNING: Failed to plan to the initial position." << std::endl;
    }

    arm_interface.clearPoseTargets();
    arm_interface.setPlanningTime(1.0); 

    std::cout << "\n>>> MoveIt 2 Interactive Planner Ready." << std::endl;

// =========================================================================
    // 5. INTERACTIVE COMMAND LOOP (OUTWARD ROLL SEARCH)
    // =========================================================================
    while (rclcpp::ok()) {
        std::cout << "\n================================================" << std::endl;
        std::cout << "Enter target X Y Z (e.g., '-0.15 0.2 0.3') or 'q' to quit: ";
        
        std::string line;
        std::getline(std::cin, line);
        if (line.empty()) continue;
        if (line == "q" || line == "Q") break;

        std::stringstream ss(line);
        double tx, ty, tz;
        if (ss >> tx >> ty >> tz) {
            std::cout << ">>> Planning motion to X:" << tx << ", Y:" << ty << ", Z:" << tz << std::endl;
            std::cout << ">>> (Pitch=-90°, Yaw=90°, searching Roll closest to 0°...)" << std::endl;
            
            // 1. Build the list of angles to test (0, 5, -5, 10, -10...)
            std::vector<double> roll_angles_to_test;
            roll_angles_to_test.push_back(0.0); // Always try perfect 0 first
            
            int step_deg = 5; // Change this to 1 if you truly want 1-degree accuracy!
            int max_deg = 90;
            
            for (int i = step_deg; i <= max_deg; i += step_deg) {
                roll_angles_to_test.push_back(i * M_PI / 180.0);  // Positive angle
                roll_angles_to_test.push_back(-i * M_PI / 180.0); // Negative angle
            }

            // 2. Execute the Search
            bool plan_found = false;
            MoveGroupInterface::Plan my_plan;

            for (double r : roll_angles_to_test) {
                geometry_msgs::msg::Pose target_pose;
                target_pose.position.x = tx;
                target_pose.position.y = ty;
                target_pose.position.z = tz;
                
                tf2::Quaternion q;
                q.setRPY(r, -M_PI/2.0, M_PI/2.0); // Roll is dynamic, Pitch/Yaw locked
                
                target_pose.orientation.x = q.x();
                target_pose.orientation.y = q.y();
                target_pose.orientation.z = q.z();
                target_pose.orientation.w = q.w();

                arm_interface.setPoseTarget(target_pose);
                
                if (arm_interface.plan(my_plan) == moveit::core::MoveItErrorCode::SUCCESS) {
                    std::cout << "    [+] Found valid plan with Roll = " << (r * 180.0 / M_PI) << "°" << std::endl;
                    plan_found = true;
                    break; // Stop searching! We found the one closest to 0.
                }
            }

            // 3. Execute or Fail
            if (plan_found) {
                std::cout << ">>> Executing path..." << std::endl;
                arm_interface.execute(my_plan);
                std::cout << ">>> Motion complete." << std::endl;
            } else {
                std::cout << "[-] Failed to find a valid plan for ANY Roll angle at these coordinates." << std::endl;
            }
            
            arm_interface.clearPoseTargets();

        } else {
            std::cout << "[-] Invalid input. Enter three numbers separated by spaces." << std::endl;
        }
    }

    // =========================================================================
    // 6. CLEANUP
    // =========================================================================
    rclcpp::shutdown();
    spinner.join(); 
    return 0;
}
