// --- Standard C++ Libraries ---
#include <memory>   
#include <thread>   
#include <iostream> 
#include <string>   
#include <sstream>  
#include <cmath>    
#include <vector>

// --- ROS 2 & MoveIt 2 Libraries ---
#include <rclcpp/rclcpp.hpp> 
#include <moveit/move_group_interface/move_group_interface.h> 
#include <moveit/planning_scene_interface/planning_scene_interface.h>
#include <moveit_msgs/msg/collision_object.hpp>
#include <shape_msgs/msg/solid_primitive.hpp>
#include <geometry_msgs/msg/pose.hpp>
#include <tf2/LinearMath/Quaternion.h>
#include <tf2/LinearMath/Vector3.h>

int main(int argc, char * argv[])
{
    // =========================================================================
    // 1. SYSTEM INITIALIZATION
    // =========================================================================
    rclcpp::init(argc, argv);
    auto node = std::make_shared<rclcpp::Node>("liquid_handler_master");

    auto executor = std::make_shared<rclcpp::executors::MultiThreadedExecutor>();
    executor->add_node(node);
    std::thread spinner([executor]() { executor->spin(); });

    using moveit::planning_interface::MoveGroupInterface;
    MoveGroupInterface arm_interface(node, "arm_group"); 

    arm_interface.setPlanningTime(10.0);
    arm_interface.setMaxVelocityScalingFactor(0.3);
    arm_interface.setMaxAccelerationScalingFactor(0.);

    // =========================================================================
    // 2. INITIAL MOTION TO START POINT
    // =========================================================================
    std::cout << ">>> Moving to start position..." << std::endl;
    arm_interface.clearPoseTargets();
    arm_interface.clearPathConstraints();

    geometry_msgs::msg::Pose start_pose;
    start_pose.position.x = 0.0;
    start_pose.position.y = -0.2;
    start_pose.position.z = 0.2;

    // The universal "Upright" mathematical state
    tf2::Quaternion q_upright;
    q_upright.setRPY(0.0, -M_PI/2.0, M_PI/2.0); 
    start_pose.orientation.x = q_upright.x();
    start_pose.orientation.y = q_upright.y();
    start_pose.orientation.z = q_upright.z();
    start_pose.orientation.w = q_upright.w();

    arm_interface.setPoseTarget(start_pose);
    MoveGroupInterface::Plan initial_plan;
    if (arm_interface.plan(initial_plan) == moveit::core::MoveItErrorCode::SUCCESS) {
        arm_interface.execute(initial_plan);
    }

    // =========================================================================
    // 3. INTERACTIVE LOOP (CONSTRAINED)
    // =========================================================================
    while (rclcpp::ok()) {
        std::cout << "\nEnter <X Y Z> (Try 0.0 -0.2 0.25 first): ";
        std::string line;
        std::getline(std::cin, line);
        if (line == "q" || line == "Q") break;

        std::stringstream ss(line);
        double tx, ty, tz;
        if (!(ss >> tx >> ty >> tz)) continue;

        // --- A. APPLY PERFECT MATHEMATICAL CONSTRAINTS ---
        moveit_msgs::msg::OrientationConstraint ocm;
        ocm.link_name = arm_interface.getEndEffectorLink();
        ocm.header.frame_id = arm_interface.getPlanningFrame();
        
        // THE FIX: Do not use getCurrentPose(). Hardcode the upright baseline!
        ocm.orientation.x = q_upright.x();
        ocm.orientation.y = q_upright.y();
        ocm.orientation.z = q_upright.z();
        ocm.orientation.w = q_upright.w();

        // Roll is completely free. Pitch/Yaw get 0.4 rad (~23 deg) to absorb 
        // starting point floating-point errors without instantly failing.
        ocm.absolute_x_axis_tolerance = 3.14159; 
        ocm.absolute_y_axis_tolerance = 0.2; 
        ocm.absolute_z_axis_tolerance = 0.2; 
        ocm.weight = 1.0;

        moveit_msgs::msg::Constraints path_constraints;
        path_constraints.orientation_constraints.push_back(ocm);
        arm_interface.setPathConstraints(path_constraints);

        // --- B. PLANNER SETTINGS ---
        arm_interface.setPlannerId("RRTConnectkConfigDefault");
        arm_interface.setPlanningTime(10.0); // Back down to 10s now that math is fixed
        arm_interface.setGoalPositionTolerance(0.02); 
        arm_interface.setGoalOrientationTolerance(0.4); 

        // --- C. GOAL SEARCH (FAST IK CHECKING) ---
        std::vector<double> roll_offsets = {0.0};
        for (int i = 1; i <= 1800; i += 1) {
        
            double angle_in_rads = (i * 0.1) * (M_PI / 180.0);
            roll_offsets.push_back(angle_in_rads);
            roll_offsets.push_back(-angle_in_rads);
        }

        // Get the underlying kinematic state to perform lightning-fast math checks
        moveit::core::RobotStatePtr kinematic_state = arm_interface.getCurrentState();
        const moveit::core::JointModelGroup* joint_model_group = kinematic_state->getJointModelGroup("arm_group");

        bool ik_found = false;
        geometry_msgs::msg::Pose best_target;

        for (double roll : roll_offsets) {
            geometry_msgs::msg::Pose target;
            target.position.x = tx;
            target.position.y = ty;
            target.position.z = tz;

            // Rotate the mathematical upright pose around its local X-axis
            tf2::Quaternion q_rot;
            q_rot.setRotation(tf2::Vector3(1, 0, 0), roll);
            tf2::Quaternion q_final = q_upright * q_rot;
            q_final.normalize();

            target.orientation.x = q_final.x();
            target.orientation.y = q_final.y();
            target.orientation.z = q_final.z();
            target.orientation.w = q_final.w();

            // CHECK INVERSE KINEMATICS DIRECTLY (Timeout: 0.01 seconds per check)
            bool found_kinematic_solution = kinematic_state->setFromIK(joint_model_group, target, 0.02);
            
            if (found_kinematic_solution) {
                best_target = target;
                ik_found = true;
                std::cout << ">>> Valid IK found at roll: " << roll * (180.0 / M_PI) << " degrees." << std::endl;
                break; // Stop immediately! We found the one closest to 0.
            }
        }

        // --- D. PLAN AND EXECUTE THE WINNING POSE ---
        if (ik_found) {
            arm_interface.setPoseTarget(best_target);
            MoveGroupInterface::Plan my_plan;
            
            std::cout << ">>> Planning trajectory to valid pose..." << std::endl;
            if (arm_interface.plan(my_plan) == moveit::core::MoveItErrorCode::SUCCESS) {
                arm_interface.execute(my_plan);
            } else {
                std::cout << "[-] Pose is reachable, but path is blocked by collisions!" << std::endl;
            }
        } else {
            std::cout << "[-] Point is completely unreachable at any roll angle." << std::endl;
        }
    }

    rclcpp::shutdown();
    spinner.join();
    return 0;
}
